{
  "name": "xx-finance-stage0",
  "version": "0.0.1",
  "private": true,
  "description": "阶段 0 交互原型及依赖探针，不是真实账本",
  "main": "spike/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts tests/*.test.cjs",
    "start": "npm run build && electron-forge start",
    "probe:electron": "electron spike/main.cjs --probe",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  },
  "type": "module"
}
