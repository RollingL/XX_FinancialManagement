{
  "name": "qianlai",
  "version": "1.0.0",
  "private": true,
  "description": "钱来财务管理系统，本地离线账本",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts tests/*.test.cjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" tests/*.test.ts tests/*.test.cjs",
    "start": "npm run build && electron-forge start",
    "probe:electron": "electron src/main/main.cjs --probe",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.11.6",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "type": "module"
}
