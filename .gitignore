# Local source baseline: ignore by default; stage reviewed paths explicitly.
# Do not force-add account data, credentials, user images or generated files.
*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/PRODUCT.md
!/DESIGN.md
!/expense_bookkeeping_spec_v1.1.md
!/package.json
!/package-lock.json
!/forge.config.cjs
!/.github/
!/.github/workflows/
!/.github/workflows/windows-portable.yml
!/.github/workflows/ci.yml
!/.nvmrc
!/.prettierrc.json
!/.prettierignore
!/vite.config.ts
!/tsconfig.json
!/docs/
!/docs/*.md
!/docs/history/
!/docs/history/*.md
!/.impeccable/
!/.impeccable/design.json
!/src/
!/src/main/
!/src/main/*.cjs
!/src/renderer/
!/src/renderer/index.html
!/src/renderer/*.ts
!/src/renderer/*.tsx
!/src/renderer/*.css
!/scripts/
!/scripts/windows/
!/scripts/windows/*.cjs
!/scripts/windows/*.cpp
!/scripts/windows/*.ps1
!/tests/
!/tests/*.ts
!/tests/*.cjs
!/tests/fixtures/
!/tests/fixtures/windows-launcher-child.cpp

# Only these clearly synthetic images belong in source control.
!/tests/fixtures/synthetic-payment.png
!/tests/fixtures/synthetic-receipt.jpg

# Private data, credentials, local evidence and generated artifacts stay local.
.local-data/
attachments/
backups/
backup/
数据/
备份/
运行记录/
截图/
截图库/
evidence/
*.sqlite*
*.db
*.db-*
.env
.env.*
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
id_rsa*
id_ed25519*
node_modules/
.npm-cache/
dist/
out/
.DS_Store
