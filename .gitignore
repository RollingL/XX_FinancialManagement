# Local source baseline: ignore by default; stage reviewed paths explicitly.
# Do not force-add account data, credentials, user images or generated files.
*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/PRODUCT.md
!/DESIGN.md
!/expense_bookkeeping_spec_v1.1.md
!/package.json
!/package-lock.json
!/forge.config.cjs
!/.github/
!/.github/workflows/
!/.github/workflows/windows-offline-trial.yml
!/vite.config.ts
!/tsconfig.json
!/docs/
!/docs/*.md
!/.impeccable/
!/.impeccable/design.json
!/prototype/
!/prototype/index.html
!/prototype/src/
!/prototype/src/*.ts
!/prototype/src/*.tsx
!/prototype/src/*.css
!/spike/
!/spike/*.cjs
!/spike/windows-launcher.cpp
!/spike/*.py
!/spike/*.spec
!/spike/build-windows-trial.ps1
!/spike/requirements.txt
!/spike/requirements-macos-arm64.lock.txt
!/spike/licenses/
!/spike/licenses/RapidOCR-LICENSE
!/spike/licenses/RapidOCR-MODEL_LICENSES.md
!/tests/
!/tests/*.ts
!/tests/*.cjs
!/tests/*.py
!/tests/fixtures/
!/tests/fixtures/ocr-worker.cjs
!/tests/fixtures/windows-launcher-child.cpp

